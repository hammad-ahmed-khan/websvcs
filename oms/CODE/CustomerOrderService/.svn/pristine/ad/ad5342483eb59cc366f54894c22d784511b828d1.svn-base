    <portType name="CustomerOrderPortType">
        <wsdl:documentation>A service to manage customer orders. It includes operations to create a customer order, query for customer
      orders, pickup/cancel items from a customer order, and return items from customer orders.</wsdl:documentation>
        <operation name="requestNewCustomerOrderId">
            <input message="tns:requestNewCustomerOrderId" wsam:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderIdRequest"
                 wsaw:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderIdRequest"/>
            <output message="tns:requestNewCustomerOrderIdResponse" wsam:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderIdResponse"/>
            <fault name="IllegalArgumentWSFaultException" message="tns:IllegalArgumentWSFaultException"
                 wsam:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderId/Fault/IllegalArgumentWSFaultException"/>
            <fault name="IllegalStateWSFaultException" message="tns:IllegalStateWSFaultException"
                 wsam:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderId/Fault/IllegalStateWSFaultException"/>
            <fault name="ValidationWSFaultException" message="tns:ValidationWSFaultException"
                 wsam:Action="http://www.oracle.com/retail/oms/integration/services/CustomerOrderService/v1/CustomerOrderPortType/requestNewCustomerOrderId/Fault/ValidationWSFaultException"/>
        </operation>
