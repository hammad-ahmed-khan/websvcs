<project name="SparePartsRequest" default='all' basedir=".">
  <description>
     For Building and Creating a java distribution and deployment file.
   </description>
  <!-- 
    First define properties, datatypes, and default tasks; then define targets.
    Any Ant tasks placed outside of any target are always executed first.
   -->
    <!-- Override default property values with an external properties file, if present. -->
  <property file='build.properties'/>
  <!-- Default property values, if not overridden elsewhere: -->
    <!-- External variables -->
  <property name='build.env' value='${arg}'/>
  <property name='app.version' value='${build.version}'/>
  <property name='app.name' value='${build.app.name}'/>
  <property name='distro-name' value='${app.name}Bean'/>
  <!-- App directories-->
  <property name='app.build.dir' location='.'/>
  <echo> Build Dir : ${app.build.dir} </echo>
  <property name='app.src.dir' location='../src'/>
  <property name='app.web.dir' location='../public_html'/>
  <property name='app.web-inf.dir' location='${app.web.dir}/WEB-INF'/>
  <echo> Source Dir : ${app.src.dir} Web Base Dir : ${app.webbase.dir} Web Dir : ${app.web.dir}</echo>
  <property name='app.lib.dir' value='${app.web-inf.dir}/lib'/>
  <property name='app.classes.dir' location='../classes'/>
  <property name='app.deploy.dir' location='../deploy'/>
  <property name='app.unfiltered.dir' location='unfiltered'/>
  <property name='omsutil.app.dir' location='../../OMSUtil'/>
  <property name="weblogic.home.dir" value="C:/Oracle/Middleware"/>
  <property name="weblogic.server.dir" value="${weblogic.home.dir}/wlserver_10.3/server"/>
  <echo>OMSUtil src folder : ${omsutil.src.dir} Oracle Integration Services : ${oracleintservices.src.dir}</echo>
  <!-- Distribution directories-->
  <property name='dist.dir' value='${app.build.dir}/dist'/>
  <property name='dist.src.dir' value='${dist.dir}/src'/>
  <property name='dist.lib.dir' value='${dist.dir}/lib'/>
  <property name='dist.classes.dir' value='${dist.dir}/classes'/>
  <property name='dist.web.dir' value='${dist.dir}/webapp'/>
  <property name='dist.web-inf.dir' value='${dist.web.dir}/WEB-INF'/>
  <property name="dist.assemble.dir" value="${dist.dir}/assemble"/>
  <tstamp prefix="build-info">
    <format property="current-date" pattern="d-MMMM-yyyy" locale="en"/>
    <format property="current-time" pattern="hh:mm:ss a z" locale="en"/>
  </tstamp>
  <!-- Set include ant runtime to 'False' suppress ant warnings with javac -->
  <presetdef name="javac">
    <javac includeantruntime="false"/>
  </presetdef>
  <path id='compile.classpath'>
    <fileset dir='${dist.lib.dir}'>
      <include name='*.jar'/>
    </fileset>
    <fileset dir="${weblogic.home.dir}/modules">
      <include name="*.jar"/>
    </fileset>
    <fileset dir="${weblogic.server.dir}/lib">
      <include name="*.jar"/>
    </fileset>
  </path>
  <!-- Delete distribution directory -->
  <delete dir="${dist.dir}"/>
  <!-- Create all distribution directories -->
  <mkdir dir='${dist.dir}'/>
  <mkdir dir='${dist.src.dir}'/>
  <mkdir dir='${dist.lib.dir}'/>
  <mkdir dir='${dist.classes.dir}'/>
  <mkdir dir='${dist.web.dir}'/>
  <echo>     Application: ${app.name} ${app.version}     Build File : ${ant.file}      Run Date   : ${build.time}     Run by     : ${user.name}     Build Dir  : ${build}     Base Dir   : ${basedir}     Java Home  : ${java.home}     Deployment host running: ${deployment.server.running}     Connected to the web   : ${jdk.javadoc.visible}   </echo>
  <!-- Now define the targets, which use the properties and datatypes defined above. -->
  <target name='clean' description="Delete all build artifacts.">
    <delete dir='${dist.dir}'/>
  </target>
  <target name='copy-classes'>
    <delete dir='${app.classes.dir}'/>
    <copy todir='${app.classes.dir}'>
      <fileset dir='${dist.classes.dir}' includes="**/*.*"/>
    </copy>
  </target>
  <target name='filterConfigFiles'>
    <filter filtersfile='filters/${build.env}.filters.properties'/>
    <copy todir='${dist.classes.dir}' filtering='true'>
      <fileset dir='${app.unfiltered.dir}' includes="*.properties"/>
    </copy>
    <copy todir='${dist.web-inf.dir}' filtering='true'>
      <fileset dir='${app.web-inf.dir}' includes="*.xml"/>
      <fileset dir='${app.unfiltered.dir}' includes="*.xml" excludes="application.xml"/>
    </copy>
  </target>
  <target name='compile' description='Compile source files and place beside source.'>
    <echo>Came Here</echo>
    <javac srcdir='${dist.src.dir}' destdir='${dist.classes.dir}' debug='true'>
      <classpath refid='compile.classpath'/>
    </javac>
    <!-- Here's a simple way of debugging a path, fileset, or patternset, using its refid: -->
    <echo>Classpath: ${toString:compile.classpath}</echo>
  </target>
  <!-- WAR/Web module targets -->
  <target name="prepare-for-war" description="Move the files after compilation to war the files">
    <copy todir="${dist.classes.dir}">
      <fileset dir="${dist.src.dir}" includes="META-INF/**"/>
    </copy>
  </target>
  <target name='distro-source' depends='filterConfigFiles'>
    <copy todir='${dist.src.dir}'>
      <fileset dir='${app.src.dir}' includes="**/*.*"/>
    </copy>
    <copy todir='${dist.lib.dir}'>
      <fileset dir='${app.lib.dir}' includes='*.*'/>
      <fileset dir="${omsutil.app.dir}/deploy" includes='*.jar'/>
    </copy>
    <copy todir='${dist.web.dir}'>
      <fileset dir='${app.web.dir}' excludes='*.properties'/>
    </copy>
    <copy todir='${dist.web-inf.dir}/lib'>
      <fileset dir='${omsutil.app.dir}/deploy' includes='*.jar'/>
    </copy>
  </target>
  <target name='build-war' depends='distro-source, compile, prepare-for-war, copy-classes'>
    <war destfile='${app.deploy.dir}/${distro-name}.war' webxml="${dist.web-inf.dir}/web.xml">
      <fileset dir='${dist.web.dir}'>
        <include name="**/*.*"/>
      </fileset>
      <classes dir="${dist.classes.dir}"/>
      <manifest>
        <attribute name="Built-By" value="${app.name}-${app.version}"/>
        <attribute name="Built-On" value="${build-info.current-date}"/>
        <attribute name="Built-At" value="${build-info.current-time}"/>
      </manifest>
    </war>
  </target>
  <target name='all' description='Create all build artifacts.' depends='build-war'>
    <echo>Finished creating all build artifacts.</echo>
  </target>
</project>














