<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:tns="http://www.oracle.com/retail/integration/base/bo/FodDesc/v1" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.0" targetNamespace="http://www.oracle.com/retail/integration/base/bo/FodDesc/v1">
  <xs:element name="FodBol">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="bill_of_lading_motive_id" type="xs:string" minOccurs="0"/>
        <xs:element name="requested_pickup_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="carrier_role" type="tns:fod_carrier_role"/>
        <xs:element name="carrier_code" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_service_code" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_name" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_address" type="xs:string" minOccurs="0"/>
        <xs:element name="carton_type_id" type="xs:long" minOccurs="0"/>
        <xs:element name="package_weight" type="xs:decimal" minOccurs="0"/>
        <xs:element name="package_weight_uom" type="xs:string" minOccurs="0"/>
        <xs:element name="ship_to_address_type" type="tns:fod_address_type"/>
        <xs:element name="alternate_ship_to_address" type="xs:string" minOccurs="0"/>
        <xs:element name="tracking_number" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="FodDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="int_fulfill_order_delivery_id" type="xs:long"/>
        <xs:element name="ext_fulfill_order_delivery_id" type="xs:string" minOccurs="0"/>
        <xs:element name="fulfill_order_id" type="xs:long"/>
        <xs:element name="store_id" type="xs:long"/>
        <xs:element name="status" type="tns:fod_status"/>
        <xs:element name="create_date" type="xs:dateTime"/>
        <xs:element name="create_user_name" type="xs:string"/>
        <xs:element name="dispatch_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="dispatch_user_name" type="xs:string" minOccurs="0"/>
        <xs:element ref="tns:FodBol"/>
        <xs:element ref="tns:FodItm" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="FodItm">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="fulfill_order_delivery_line_id" type="xs:long"/>
        <xs:element name="fulfill_order_line_id" type="xs:long"/>
        <xs:element name="quantity" type="xs:decimal"/>
        <xs:element name="case_size" type="xs:decimal"/>
        <xs:element name="uin_col" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="fod_status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="IN_PROGRESS"/>
      <xs:enumeration value="SUBMITTED"/>
      <xs:enumeration value="COMPLETED"/>
      <xs:enumeration value="CANCELED"/>
      <xs:enumeration value="UNKNOWN"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fod_carrier_role">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SENDER"/>
      <xs:enumeration value="RECEIVER"/>
      <xs:enumeration value="THIRD_PARTY"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="fod_address_type">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BUSINESS"/>
      <xs:enumeration value="POSTAL"/>
      <xs:enumeration value="RETURNS"/>
      <xs:enumeration value="ORDER"/>
      <xs:enumeration value="INVOICE"/>
      <xs:enumeration value="REMITTANCE"/>
      <xs:enumeration value="NO_VALUE"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>