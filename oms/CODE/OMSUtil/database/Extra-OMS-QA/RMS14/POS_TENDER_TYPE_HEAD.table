      <properties>
        <entry>
          <key>Comment</key>
          <value class="java.lang.String">Contains the tender type classification.  Valid values where code_type = TENT include: CASH - Cash, CHECK - Check, CCARD - Credit, COUPON - Coupon, LOTTRY - Lottery, FSTAMP - Food Stamp, DCARD - Debit Card, VOUCH - Voucher, MORDER - Money Order, ERR - Error, SOCASS - Social Assistance, TERM - Termination Record, DRIVEO - Drive Off, EBS - Electronic Benefits (Food Stamps)</value>
        </entry>
