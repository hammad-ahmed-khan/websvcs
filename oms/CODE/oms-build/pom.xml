<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.extra</groupId>
	<artifactId>oms-build</artifactId>
	<version>0.0.1</version>
	<packaging>pom</packaging>

	<name>oms-build</name>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java-version>1.7</java-version>
		<maven.compiler.source>1.7</maven.compiler.source>
		<maven.compiler.target>1.7</maven.compiler.target>
	</properties>

	<profiles>
		<profile>
			<id>dev</id>
			<properties>
				<project.profile>dev</project.profile>
			</properties>
		</profile>
		<profile>
			<id>eqa</id>
			<properties>
				<project.profile>eqa</project.profile>
			</properties>
		</profile>
	</profiles>

	<modules>
		<module>../OMSUtil</module>
		<module>../extra-sim</module>
		<module>../NOON/ExtraServiceRest</module>
		<module>../OMSCustomerOrder</module>
		<module>../OMSCOCancellation</module>
		<module>../CustomerOrderBeanPOS</module>
	</modules>

	<build>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.1.0</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>
									../oms-build/build/${project.profile}.properties</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.8</version>
				<executions>
					<execution>
						<phase>package</phase>
						<configuration>
							<target>
								<exec executable="cmd.exe"
									spawn="false">
									<arg value="/c" />
									<arg value="${project.basedir}/../oms-build/build/exec-ant.bat" />
									<arg value="${java.home.dir}"/>
									<arg value="${ant.home.dir}"/>
									<arg value="${project.basedir}/build/build.xml"/>
									<arg value="${project.basedir}/build"/>
									<arg value="${project.profile}"/>
									<arg value="${weblogic.home.dir}"/>
									<arg value="${weblogic.server.url}"/>
									<arg value="${weblogic.server.username}"/>
									<arg value="${weblogic.server.password}"/>
									<arg value="${weblogic.server.target}"/>
								</exec>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>