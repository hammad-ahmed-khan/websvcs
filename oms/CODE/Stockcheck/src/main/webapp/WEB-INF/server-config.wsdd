<ns1:deployment xmlns="http://xml.apache.org/axis/wsdd/" xmlns:java="http://xml.apache.org/axis/wsdd/providers/java" xmlns:ns1="http://xml.apache.org/axis/wsdd/">
 <ns1:globalConfiguration>
  <ns1:parameter name="sendMultiRefs" value="true"/>
  <ns1:parameter name="disablePrettyXML" value="true"/>
  <ns1:parameter name="adminPassword" value="admin"/>
  <ns1:parameter name="attachments.Directory" value="E:\noon-webservices\Stockcheck\src\main\webapp\WEB-INF\attachments"/>
  <ns1:parameter name="dotNetSoapEncFix" value="true"/>
  <ns1:parameter name="enableNamespacePrefixOptimization" value="false"/>
  <ns1:parameter name="sendXMLDeclaration" value="true"/>
  <ns1:parameter name="sendXsiTypes" value="true"/>
  <ns1:parameter name="attachments.implementation" value="org.apache.axis.attachments.AttachmentsImpl"/>
  <ns1:requestFlow>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="session"/>
   </ns1:handler>
   <ns1:handler type="java:org.apache.axis.handlers.JWSHandler">
    <ns1:parameter name="scope" value="request"/>
    <ns1:parameter name="extension" value=".jwr"/>
   </ns1:handler>
  </ns1:requestFlow>
 </ns1:globalConfiguration>
 <ns1:handler name="URLMapper" type="java:org.apache.axis.handlers.http.URLMapper"/>
 <ns1:handler name="LocalResponder" type="java:org.apache.axis.transport.local.LocalResponder"/>
 <ns1:handler name="Authenticate" type="java:org.apache.axis.handlers.SimpleAuthenticationHandler"/>
 <ns1:service name="InventoryDetailPort" provider="java:RPC" style="wrapped" use="literal">
  <ns1:parameter name="wsdlServicePort" value="InventoryDetailPort"/>
  <ns1:parameter name="schemaQualified" value="http://www.oracle.com/retail/integration/base/bo/InvAvailCriVo/v1,http://www.oracle.com/retail/integration/base/bo/InvAvailDesc/v1,http://www.oracle.com/retail/integration/base/bo/InvAvailColDesc/v1,http://www.oracle.com/retail/integration/services/exception/v1"/>
  <ns1:parameter name="className" value="com.oracle.www.retail.rms.integration.services.InventoryDetailService.v1.InventoryDetailPortBindingSkeleton"/>
  <ns1:parameter name="allowedMethods" value="*"/>
  <ns1:parameter name="typeMappingVersion" value="1.2"/>
  <ns1:parameter name="wsdlServiceElement" value="InventoryDetailService"/>
  <ns1:parameter name="wsdlTargetNamespace" value="http://www.oracle.com/retail/rms/integration/services/InventoryDetailService/v1"/>
  <ns1:parameter name="wsdlPortType" value="InventoryDetailPortType"/>
  <ns1:parameter name="schemaUnqualified" value="http://www.oracle.com/retail/rms/integration/services/InventoryDetailService/v1"/>
  <ns2:typeMapping deserializer="org.apache.axis.encoding.ser.EnumDeserializerFactory" encodingStyle="" qname="ns1:store_pickup_ind" serializer="org.apache.axis.encoding.ser.EnumSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailCriVo.v1.Store_pickup_ind" xmlns:ns1="http://www.oracle.com/retail/integration/base/bo/InvAvailCriVo/v1" xmlns:ns2="http://xml.apache.org/axis/wsdd/"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns2:&gt;InvAvailColDesc" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailColDesc.v1.InvAvailColDesc" xmlns:ns2="http://www.oracle.com/retail/integration/base/bo/InvAvailColDesc/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.EnumDeserializerFactory" encodingStyle="" qname="ns3:pack_calculate_ind" serializer="org.apache.axis.encoding.ser.EnumSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailDesc.v1.Pack_calculate_ind" xmlns:ns3="http://www.oracle.com/retail/integration/base/bo/InvAvailDesc/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.EnumDeserializerFactory" encodingStyle="" qname="ns4:loc_type" serializer="org.apache.axis.encoding.ser.EnumSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailDesc.v1.Loc_type" xmlns:ns4="http://www.oracle.com/retail/integration/base/bo/InvAvailDesc/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns5:&gt;BusinessProblemDetail" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.services.exception.v1.BusinessProblemDetail" xmlns:ns5="http://www.oracle.com/retail/integration/services/exception/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns6:&gt;InvAvailDesc" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailDesc.v1.InvAvailDesc" xmlns:ns6="http://www.oracle.com/retail/integration/base/bo/InvAvailDesc/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns7:&gt;InvAvailCriVo" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailCriVo.v1.InvAvailCriVo" xmlns:ns7="http://www.oracle.com/retail/integration/base/bo/InvAvailCriVo/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns8:&gt;ValidationWSFaultException" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.services.exception.v1.ValidationWSFaultException" xmlns:ns8="http://www.oracle.com/retail/integration/services/exception/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns9:&gt;IllegalStateWSFaultException" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.services.exception.v1.IllegalStateWSFaultException" xmlns:ns9="http://www.oracle.com/retail/integration/services/exception/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns10:&gt;ProblemDetailEntry" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.services.exception.v1.ProblemDetailEntry" xmlns:ns10="http://www.oracle.com/retail/integration/services/exception/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns11:&gt;InvLocation" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailCriVo.v1.InvLocation" xmlns:ns11="http://www.oracle.com/retail/integration/base/bo/InvAvailCriVo/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.EnumDeserializerFactory" encodingStyle="" qname="ns12:loc_type" serializer="org.apache.axis.encoding.ser.EnumSerializerFactory" type="java:com.oracle.www.retail.integration.base.bo.InvAvailCriVo.v1.Loc_type" xmlns:ns12="http://www.oracle.com/retail/integration/base/bo/InvAvailCriVo/v1"/>
  <ns1:typeMapping deserializer="org.apache.axis.encoding.ser.BeanDeserializerFactory" encodingStyle="" qname="ns13:&gt;IllegalArgumentWSFaultException" serializer="org.apache.axis.encoding.ser.BeanSerializerFactory" type="java:com.oracle.www.retail.integration.services.exception.v1.IllegalArgumentWSFaultException" xmlns:ns13="http://www.oracle.com/retail/integration/services/exception/v1"/>
 </ns1:service>
 <ns1:service name="AdminService" provider="java:MSG">
  <ns1:parameter name="allowedMethods" value="AdminService"/>
  <ns1:parameter name="enableRemoteAdmin" value="false"/>
  <ns1:parameter name="className" value="org.apache.axis.utils.Admin"/>
  <ns1:namespace>http://xml.apache.org/axis/wsdd/</ns1:namespace>
 </ns1:service>
 <ns1:service name="Version" provider="java:RPC">
  <ns1:parameter name="allowedMethods" value="getVersion"/>
  <ns1:parameter name="className" value="org.apache.axis.Version"/>
 </ns1:service>
 <ns1:transport name="http">
  <ns1:requestFlow>
   <ns1:handler type="URLMapper"/>
   <ns1:handler type="java:org.apache.axis.handlers.http.HTTPAuthHandler"/>
  </ns1:requestFlow>
  <ns1:parameter name="qs:list" value="org.apache.axis.transport.http.QSListHandler"/>
  <ns1:parameter name="qs:wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
  <ns1:parameter name="qs.list" value="org.apache.axis.transport.http.QSListHandler"/>
  <ns1:parameter name="qs.method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <ns1:parameter name="qs:method" value="org.apache.axis.transport.http.QSMethodHandler"/>
  <ns1:parameter name="qs.wsdl" value="org.apache.axis.transport.http.QSWSDLHandler"/>
 </ns1:transport>
 <ns1:transport name="local">
  <ns1:responseFlow>
   <ns1:handler type="LocalResponder"/>
  </ns1:responseFlow>
 </ns1:transport>
</ns1:deployment>