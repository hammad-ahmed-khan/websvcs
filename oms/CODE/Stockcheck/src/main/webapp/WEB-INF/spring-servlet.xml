<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="
        http://www.springframework.org/schema/beans     
        http://www.springframework.org/schema/beans/spring-beans-4.0.xsd
        http://www.springframework.org/schema/context 
        http://www.springframework.org/schema/context/spring-context-4.0.xsd
        http://www.springframework.org/schema/mvc
        http://www.springframework.org/schema/mvc/spring-mvc-4.0.xsd">

 <context:component-scan base-package="com.extra.restservice.*"/>
 <mvc:annotation-driven />
 <bean
     class="org.springframework.beans.factory.config.PropertyPlaceholderConfigurer">
        <property name="locations">
            <list>
                <value>classpath:application.properties</value>
            </list>
        </property>
        <property name="ignoreResourceNotFound" value="true"/>
    </bean>
	
	<bean id="omsDatasource" class="org.springframework.jndi.JndiObjectFactoryBean">
		<property name="jndiName" value="${db.oms.jndi}" />
	</bean>
	
	<bean id="omsJdbcTemplate" class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg index="0" ref="omsDatasource"></constructor-arg>
	</bean>

	<bean id="dasDatasource" class="org.springframework.jndi.JndiObjectFactoryBean">
		<property name="jndiName" value="${db.das.jndi}" />
	</bean>
	
	<bean id="dasJdbcTemplate" class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg index="0" ref="dasDatasource"></constructor-arg>
	</bean>

	<bean id="simDatasource" class="org.springframework.jndi.JndiObjectFactoryBean">
		<property name="jndiName" value="${db.sim.jndi}" />
	</bean>
	
	<bean id="simJdbcTemplate" class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg index="0" ref="simDatasource"></constructor-arg>
	</bean>
 
</beans>