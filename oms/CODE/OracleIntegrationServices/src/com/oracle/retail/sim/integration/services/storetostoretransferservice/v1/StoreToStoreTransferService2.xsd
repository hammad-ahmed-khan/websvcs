<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:tns="http://www.oracle.com/retail/integration/base/bo/StsTsfDesc/v1" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.0" targetNamespace="http://www.oracle.com/retail/integration/base/bo/StsTsfDesc/v1">
  <xs:element name="StsTsfBol">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="bill_of_lading_motive_id" type="xs:string" minOccurs="0"/>
        <xs:element name="requested_pickup_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="carrier_role" type="tns:sts_tsf_carrier_role"/>
        <xs:element name="carrier_code" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_service_code" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_name" type="xs:string" minOccurs="0"/>
        <xs:element name="carrier_address" type="xs:string" minOccurs="0"/>
        <xs:element name="carton_type_id" type="xs:long" minOccurs="0"/>
        <xs:element name="package_weight" type="xs:decimal" minOccurs="0"/>
        <xs:element name="package_weight_uom" type="xs:string" minOccurs="0"/>
        <xs:element name="alternate_ship_to_address" type="xs:string" minOccurs="0"/>
        <xs:element name="tracking_number" type="xs:string" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StsTsfDesc">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="transfer_id" type="xs:long"/>
        <xs:element name="sending_store_id" type="xs:long"/>
        <xs:element name="receiving_store_id" type="xs:long"/>
        <xs:element name="create_store_id" type="xs:long"/>
        <xs:element name="external_id" type="xs:string" minOccurs="0"/>
        <xs:element name="status" type="tns:sts_tsf_status"/>
        <xs:element name="create_user_name" type="xs:string"/>
        <xs:element name="update_user_name" type="xs:string" minOccurs="0"/>
        <xs:element name="approval_user_name" type="xs:string" minOccurs="0"/>
        <xs:element name="ship_user_name" type="xs:string" minOccurs="0"/>
        <xs:element name="receive_user_name" type="xs:string" minOccurs="0"/>
        <xs:element name="create_date" type="xs:dateTime"/>
        <xs:element name="update_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="approve_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="ship_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="receive_date" type="xs:dateTime" minOccurs="0"/>
        <xs:element name="request_comments" type="xs:string" minOccurs="0"/>
        <xs:element name="transfer_comments" type="xs:string" minOccurs="0"/>
        <xs:element name="delivery_slot_id" type="xs:string" minOccurs="0"/>
        <xs:element name="context_type_id" type="xs:string" minOccurs="0"/>
        <xs:element name="context_value" type="xs:string" minOccurs="0"/>
        <xs:element ref="tns:StsTsfBol" minOccurs="0"/>
        <xs:element ref="tns:StsTsfItm" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:element name="StsTsfItm">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="line_id" type="xs:long"/>
        <xs:element name="item_id" type="xs:string"/>
        <xs:element name="requested_quantity" type="xs:decimal" minOccurs="0"/>
        <xs:element name="approved_quantity" type="xs:decimal" minOccurs="0"/>
        <xs:element name="transfer_quantity" type="xs:decimal" minOccurs="0"/>
        <xs:element name="received_quantity" type="xs:decimal" minOccurs="0"/>
        <xs:element name="damaged_quantity" type="xs:decimal" minOccurs="0"/>
        <xs:element name="case_size" type="xs:decimal"/>
        <xs:element name="uin_col" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:simpleType name="sts_tsf_status">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NEW"/>
      <xs:enumeration value="PENDING"/>
      <xs:enumeration value="REJECTED"/>
      <xs:enumeration value="CANCELED_REQUEST"/>
      <xs:enumeration value="IN_PROGRESS"/>
      <xs:enumeration value="DISPATCHED"/>
      <xs:enumeration value="SUBMITTED"/>
      <xs:enumeration value="RECEIVING"/>
      <xs:enumeration value="RECEIVED"/>
      <xs:enumeration value="CANCELED_TRANSFER"/>
      <xs:enumeration value="UNKNOWN"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="sts_tsf_carrier_role">
    <xs:restriction base="xs:string">
      <xs:enumeration value="THIRD_PARTY"/>
      <xs:enumeration value="SENDER"/>
      <xs:enumeration value="UNKNOWN"/>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>